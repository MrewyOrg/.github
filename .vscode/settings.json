{
  // Terminal
  "terminal.integrated.shellIntegration.enabled": true,

  "terminal.integrated.suggest.insertTrailingSpace": false,
  "terminal.integrated.suggest.showStatusBar": true,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.suggest.quickSuggestions": {
    "commands": "on",
    "arguments": "on",
    "unknown": "off"
  },

  "terminal.integrated.tabs.showActions": "singleTerminalOrNarrow",
  "terminal.integrated.tabs.title": "mrewyorg${separator}${process}",
  "terminal.integrated.tabs.showActiveTerminal": "always",

  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.enablePersistentSessions": false,

  "terminal.integrated.gpuAcceleration": "auto",
  "terminal.integrated.enableImages": false,

  "terminal.integrated.smoothScrolling": true,

  "terminal.integrated.initialHint": false,

  // Editor
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",

  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,

  "editor.smoothScrolling": true,

  // Files
  "files.readonlyInclude": {
    ".husky/_/**/*": true,
    "node_modules/**/*": true,
    "package-lock.json": true
  },
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.autoSave": "onFocusChange",
  "files.insertFinalNewline": true,
  "files.encoding": "utf8",
  "files.eol": "\n",

  "files.associations": {
    "**/.husky/commit-msg": "shellscript",
    "**/.husky/pre-commit": "shellscript"
  },

  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.trimTrailingWhitespace": false
  },

  "files.watcherExclude": { "**/.husky/_/**": true },

  // Search
  "search.exclude": { "**/.husky/_/**": true },
  "search.useIgnoreFiles": true,

  // Source Control
  "scm.repositories.selectionMode": "single",
  "scm.repositories.explorer": true,

  "scm.showInputActionButton": false,

  "scm.graph.badges": "all",

  // Workbench
  "workbench.list.smoothScrolling": true,
  "workbench.iconTheme": "vscode-icons",
  "workbench.startupEditor": "none",

  // Git
  "git.enableCommitSigning": true,
  "git.alwaysSignOff": false,
  "git.autofetch": true,

  // GitHub
  "githubPullRequests.defaultDeletionMethod.selectLocalBranch": false,
  "githubPullRequests.defaultDeletionMethod.selectRemote": false,

  // Prettier
  "prettier.requireConfig": true,
  "prettier.configPath": ".prettierrc.json",
  "prettier.ignorePath": ".prettierignore",

  // Markdownlint
  "markdownlint.configFile": ".markdownlint-cli2.jsonc",
  "markdownlint.run": "onSave",

  // Spell checking
  "cSpell.mergeCSpellSettings": false,

  // Commitlint
  "commitlint.config.file": ".commitlintrc.json",
  "commitlint.preferBundledLibraries": false,

  // npm
  "npm.packageManager": "npm",
  "npm.scriptRunner": "npm",

  // GitLens
  "gitlens.ai.enabled": false,
  "gitlens.plusFeatures.enabled": false,
  "gitlens.telemetry.enabled": false,
  "gitlens.virtualRepositories.enabled": false,

  // vscode-icons
  "vsicons.customIconFolderPath": "assets",
  "vsicons.associations.files": [
    { "icon": "mrewyorg-icon", "extensions": ["README.md"], "filename": true, "format": "png" }
  ],

  // Telemetry
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,

  // Other
  "diffEditor.ignoreTrimWhitespace": false,

  "chat.disableAIFeatures": false
}
