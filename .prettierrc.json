{
  "endOfLine": "lf",
  "experimentalOperatorPosition": "start",
  "experimentalTernaries": true,
  "insertPragma": true,
  "objectWrap": "collapse",
  "plugins": ["prettier-plugin-sh"],
  "printWidth": 100,
  "proseWrap": "always",
  "quoteProps": "consistent",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false
}
