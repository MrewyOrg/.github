{
  "version": "0.2",
  "language": "en",
  "readonly": true,
  "description": "mrewyOrgCSpell",

  "useGitignore": true,
  "enableGlobDot": true,
  "caseSensitive": false,
  "allowCompoundWords": true,
  "validateDirectives": true,
  "ignoreRandomStrings": true,

  "dictionaries": [],
  "ignorePaths": [
    ".git/gk",
    ".git/hooks",
    ".git/info",
    ".git/logs",
    ".git/objects",
    ".git/refs",
    ".git/config",
    ".git/description",
    ".git/FETCH_HEAD",
    ".git/HEAD",
    ".git/index",
    ".git/ORIG_HEAD",
    ".git/packed-refs"
  ],

  "words": [
    // Names
    "Mrewy",
    "MrewyOrg",

    // Extensions
    "eamodio",
    "esbenp",
    "Anson",
    "joshbolduc",
    "vsicons",
    "kohler"
  ],
  "ignoreWords": []
}
