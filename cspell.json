{
  "version": "0.2",
  "language": "en",
  "readonly": true,
  "description": "mrewyOrgCSpell",

  "useGitignore": true,
  "enableGlobDot": true,
  "allowCompoundWords": true,
  "validateDirectives": true,

  "ignorePaths": [
    ".git/worktrees",
    ".git/gk",
    ".git/hooks",
    ".git/info",
    ".git/logs",
    ".git/objects",
    ".git/refs",
    ".git/config",
    ".git/description",
    ".git/FETCH_HEAD",
    ".git/HEAD",
    ".git/index",
    ".git/ORIG_HEAD",
    ".git/packed-refs",
    "**/node_modules/**",
    "**/package-lock.json"
  ],

  "words": [
    // Names
    "Mrewy",
    "MrewyOrg",
    "Botge",
    "BTTV",
    "FFZ",
    "commitlintrc",
    "webp",

    // Extensions
    "eamodio",
    "esbenp",
    "Anson",
    "joshbolduc",
    "vsicons",
    "kohler"
  ],
  "ignoreWords": []
}
