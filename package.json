{
  "name": "mrewyorg",
  "version": "2.0.0",
  "private": true,
  "description": "Organization profile, branding, and shared community files for MrewyOrg.",
  "keywords": [
    "mrewyorg",
    "mrewy",
    "org",
    "readme"
  ],
  "bugs": {
    "url": "https://github.com/MrewyOrg/.github/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrewyOrg/.github.git"
  },
  "license": "MIT",
  "author": "Mrewy",
  "contributors": [],
  "type": "module",
  "main": "profile/README.md",
  "scripts": {
    "check": "npm run prettier:check && npm run markdownlint && npm run cspell",
    "cspell": "cspell . --verbose",
    "markdownlint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "prepare": "sh .husky/install.sh",
    "prettier": "prettier . --write",
    "prettier:check": "prettier . --check"
  },
  "allowScripts": {},
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/format": "^21.2.3",
    "cspell": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "prettier-plugin-sh": "^0.20.2"
  },
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.20.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
